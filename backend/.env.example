# Backend Environment Variables
# Copy this file to .env and adjust values for your environment

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://simulator:simulator123@localhost:5432/whatsapp_simulator
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_simulator
DB_USER=simulator
DB_PASSWORD=simulator123

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=educational_demo_secret_change_in_production
JWT_EXPIRES_IN=24h

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_SALT_ROUNDS=10

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# API Keys (for external services - educational purposes only)
SMS_API_KEY=demo_key_for_educational_purposes
EMAIL_API_KEY=demo_key_for_educational_purposes

# Monitoring (Prometheus/Grafana)
ENABLE_METRICS=true
METRICS_PORT=9090

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Educational Disclaimer
EDUCATIONAL_DEMO=true
DISCLAIMER_TEXT=This is an educational simulation. No real attacks are performed.

# Development Features
ENABLE_SWAGGER=true
ENABLE_GRAPHIQL=true

# Database Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=60000
