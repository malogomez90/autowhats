# Frontend Environment Variables
# Copy this file to .env and adjust values for your environment

# Application Configuration
VITE_APP_TITLE="WhatsApp Security Simulator"
VITE_APP_DESCRIPTION="Educational demo showing WhatsApp security threats - NOT a real hacking tool"
VITE_APP_VERSION=1.0.0

# API Configuration
VITE_API_URL=http://localhost:5000/api
VITE_API_TIMEOUT=30000

# Security Configuration
VITE_ENABLE_STRICT_MODE=true
VITE_ENABLE_SECURITY_HEADERS=true

# Feature Flags
VITE_ENABLE_SIMULATIONS=true
VITE_ENABLE_EDUCATIONAL_TIPS=true
VITE_ENABLE_STATISTICS=true
VITE_ENABLE_DARK_MODE=true

# Analytics (Educational purposes only)
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=UA-XXXXX-Y

# Development Configuration
VITE_DEVELOPMENT_MODE=true
VITE_DEBUG_LOGGING=false

# Build Configuration
VITE_BUILD_SOURCEMAP=true
VITE_BUILD_MINIFY=true

# Educational Disclaimer
VITE_EDUCATIONAL_DEMO=true
VITE_DISCLAIMER_TEXT="⚠️ EDUCATIONAL DEMO ONLY: This is a simulation for learning purposes. No real attacks are performed."

# External Resources
VITE_SECURITY_TIPS_URL=https://www.whatsapp.com/security
VITE_PHISHING_INFO_URL=https://www.phishing.org/what-is-phishing
VITE_CISA_GUIDE_URL=https://www.cisa.gov/stopransomware

# UI Configuration
VITE_PRIMARY_COLOR=#3b82f6
VITE_SECONDARY_COLOR=#10b981
VITE_ACCENT_COLOR=#8b5cf6

# Cache Configuration
VITE_CACHE_VERSION=1.0.0
VITE_CACHE_MAX_AGE=3600

# PWA Configuration (Optional)
VITE_ENABLE_PWA=false
VITE_PWA_NAME="WhatsApp Security Simulator"
VITE_PWA_SHORT_NAME="WSSim"
VITE_PWA_THEME_COLOR=#1f2937
VITE_PWA_BACKGROUND_COLOR=#111827